# ==============================================================================
# Farhan AI — Production Hardened Environment Variables
# Copy this file to .env.local and populate your values.
# DO NOT commit .env.local or any real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Deployment Mode
# ------------------------------------------------------------------------------
# NODE_ENV: "development" | "production" | "test"
NODE_ENV=development

# DEPLOYMENT_MODE: "local_dev" | "private" | "production"
# - local_dev: Permissive local testing, mock fallbacks, authentication optional
# - private: Internal network / VPN deployment, token authentication if configured
# - production: STRICT security enforcement. Requires high-entropy FARHAN_AUTH_TOKEN,
#               mandates authentication for ALL sensitive endpoints (GET/POST),
#               enforces rate limits, HSTS, and CSP headers.
DEPLOYMENT_MODE=local_dev

# ------------------------------------------------------------------------------
# 2. Authentication & Authorization (CRITICAL IN PRODUCTION)
# ------------------------------------------------------------------------------
# Required in production mode (minimum 16 chars, high entropy, no weak words).
# Clients authenticate using either:
#   Authorization: Bearer <token>
#   x-farhan-token: <token>
FARHAN_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 3. Network & Proxy Security
# ------------------------------------------------------------------------------
# Comma-separated list of trusted reverse proxy IP addresses (e.g. Nginx, Cloudflare, AWS ALB).
# IMPORTANT: Farhan AI will ONLY inspect X-Forwarded-For or X-Real-IP if the direct peer
# IP matches one of these trusted proxies. Never leave this open to 0.0.0.0.
TRUSTED_PROXIES=127.0.0.1,::1

# Port for Next.js server
PORT=3000

# ------------------------------------------------------------------------------
# 4. Computer Control & Browser Automation Policy
# ------------------------------------------------------------------------------
# ALLOWLIST_MODE: "strict" | "permissive"
# - strict: Navigation is ONLY permitted to explicitly listed domains in COMPUTER_ALLOWLIST.
# - permissive: Navigation permitted to public domains.
# NOTE: Regardless of mode, loopback, RFC 1918 private IPs, link-local, and cloud metadata
# (169.254.169.254) are UNCONDITIONALLY BLOCKED to prevent SSRF.
ALLOWLIST_MODE=strict
COMPUTER_ALLOWLIST=indeed.com,linkedin.com,glassdoor.com,wellfound.com,github.com

# ------------------------------------------------------------------------------
# 5. Persistent SQLite Storage
# ------------------------------------------------------------------------------
# Path to SQLite database file. Defaults to data/farhan_ai.db in workspace root.
DATABASE_URL=file:./data/farhan_ai.db

# ------------------------------------------------------------------------------
# 6. AI Inference Providers
# ------------------------------------------------------------------------------
# Active Provider: "gemini" | "openai" | "groq" | "mock"
# Default is "mock" which enables local testing without external API dependencies.
AI_PROVIDER=mock

# Google Gemini
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Groq (Ultra-fast inference)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 7. Voice & Audio Providers
# ------------------------------------------------------------------------------
# Speech-To-Text: "mock" | "server" | "browser"
STT_PROVIDER=mock

# Text-To-Speech: "mock" | "server" | "browser"
TTS_PROVIDER=mock
